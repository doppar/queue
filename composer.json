{
    "name": "doppar/queue",
    "description": "A lightweight queue management library for the Doppar framework.",
    "type": "library",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/doppar/queue/issues",
        "source": "https://github.com/doppar/queue"
    },
    "authors": [
        {
            "name": "Mahedi Hasan",
            "email": "mahedy150101@gmail.com"
        }
    ],
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^13.3",
        "doppar/framework": "4.*"
    },
    "autoload": {
        "psr-4": {
            "Doppar\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doppar\\Queue\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "require": {
        "php": "^8.5",
        "opis/closure": "^4.5"
    },
    "prefer-stable": true
}